# Copy to apps/web/.env.local for the site. Leave blanks for anything you don't use.
# Nothing in this file is a real secret.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true to show the Pond films in the portfolio. The live site has this on.
NEXT_PUBLIC_SHOW_POND_WORK=

# Orders and the "I'm not a robot" check
ALTCHA_HMAC_KEY=
ADMIN_KEY=

# Crypto payments (NOWPayments). Card payments stay a manual SadaBiz link.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Order storage on Vercel. Locally, orders are saved in apps/web/data/orders.
BLOB_READ_WRITE_TOKEN=

# Optional director. Off when every key is blank (the rule planner runs instead).
# Free keys are tried first. A paid key is used only when no free key is set,
# unless HARKAT_DIRECTOR_ALLOW_PAID=1. See HANDOFF.md for which key to create.
# Cost is logged as `harkat director ... usd=`. Free tiers log 0.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=
OPENAI_API_KEY=
HARKAT_LLM_API_KEY=
HARKAT_LLM_BASE_URL=
HARKAT_LLM_MODEL=
HARKAT_LLM_PRICE_IN=
HARKAT_LLM_PRICE_OUT=
# 0 forces the rule planner. 1 or 3 forces that many director calls.
HARKAT_DIRECTOR=
HARKAT_DIRECTOR_STEPS=
# Milliseconds for one preview. Under 14000 uses one model call. 20000 uses three.
HARKAT_DIRECTOR_BUDGET_MS=
# Daily caps, per server instance. Cache hits are free.
HARKAT_DIRECTOR_IP_DAY=
HARKAT_DIRECTOR_GLOBAL_DAY=
HARKAT_DIRECTOR_TOKEN_BUDGET=
HARKAT_DIRECTOR_ALLOW_PAID=
