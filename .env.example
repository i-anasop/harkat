# Copy to apps/web/.env.local for the site. Leave blanks for anything you don't use.
# Nothing in this file is a real secret.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true to show the Pond films in the portfolio. The live site has this on.
NEXT_PUBLIC_SHOW_POND_WORK=

# Orders and the "I'm not a robot" check
ALTCHA_HMAC_KEY=
ADMIN_KEY=

# Crypto payments (NOWPayments). Card payments stay a manual SadaBiz link.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Order storage on Vercel. Locally, orders are saved in apps/web/data/orders.
BLOB_READ_WRITE_TOKEN=

# Optional planner. Off when every key is blank. OpenAI-compatible chat completions.
# The model may only return a scene plan. It never writes animation.
# Cost is logged from HARKAT_LLM_PRICE_IN / _OUT (dollars per million tokens).
# Defaults match gpt-4o-mini list price: 0.15 in, 0.60 out.
GROQ_API_KEY=
OPENAI_API_KEY=
HARKAT_LLM_API_KEY=
HARKAT_LLM_BASE_URL=
HARKAT_LLM_MODEL=
HARKAT_LLM_PRICE_IN=
HARKAT_LLM_PRICE_OUT=
